{
  "name": "@lmliheng/ai_git",
  "version": "1.0.8",
  "description": "git 提交前的ai总结npm库",
  "keywords": ["agent","git","comsume"],
  "author": "lmliheng",
  "license": "MIT",
  "main": "./dist/ai_git.cjs",
  "module": "./dist/ai_git.mjs",
  "exports": {
    ".": {
      "import": "./dist/ai_git.mjs",
      "require": "./dist/ai_git.cjs"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c",
    "p": "npm publish --registry=https://registry.npmjs.org/",
    "comsume": "node --env-file=.env test/test.js comsume"
  },
  "type": "module",
  "devDependencies": {
    "rollup": "^4.62.4"
  }
}